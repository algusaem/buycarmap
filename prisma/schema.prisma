// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"

}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  // Nullable: OAuth-only accounts never set a password. Credentials login
  // must guard on this (see lib/auth/authorize.ts).
  password String?
  name     String?
  // Named `image` (not `avatarUrl`) because the NextAuth Prisma adapter writes
  // the OAuth profile picture to this exact field.
  image    String?

  emailVerified DateTime?

  // Which language to write this account's alert emails in. Null on accounts
  // that predate the column and on anyone who has never touched the language
  // switcher, in which case DEFAULT_LOCALE applies.
  //
  // It has to be stored because the alert runner is a cron: there is no request
  // to read a cookie or accept-language from, and the default locale is `es`,
  // so falling back would mail Spanish to every English-speaking user.
  locale String?

  // AES-256-GCM ciphertext, not a hash: verifying a code means recomputing the
  // HMAC from the original secret, so it has to be recoverable. The key lives
  // in TWO_FACTOR_ENCRYPTION_KEY, so the database alone is not enough.
  twoFactorSecret String?
  // Null while enrolment is half-finished — a secret exists but no code has
  // been verified yet, so 2FA is NOT enforced. Only this field gates login.
  twoFactorEnabledAt DateTime?
  // Highest TOTP counter step already accepted. Anything at or below it is
  // refused, so a code seen over someone's shoulder cannot be replayed inside
  // its own 30-second window.
  twoFactorLastStep Int?
  // Bumped on every password change / reset. The JWT callback compares the
  // token's issue time against this and revokes older sessions, which is how
  // "sign out everywhere" works under a stateless JWT strategy.
  passwordChangedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  accounts               Account[]
  sessions               Session[]
  favorites              Favorite[]
  alerts                 Alert[]
  searchHistories        SearchHistory[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationToken EmailVerificationToken[]
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]
}

// The way back in when the authenticator is lost. Password reset deliberately
// does not bypass 2FA — if it did, control of the mailbox would defeat the
// second factor entirely — so without these a lost phone means a lost account.
//
// Stored as a plain SHA-256 digest rather than bcrypt: the codes carry ~73 bits
// of entropy, so there is no dictionary to grind, and a unique index makes
// redemption a single indexed lookup instead of ten slow comparisons.
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Required by @next-auth/prisma-adapter to link OAuth identities to a User.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Adapter-shaped session table. Unused while `session.strategy` is "jwt", but
// the adapter's type contract requires the model to exist.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Required by @next-auth/prisma-adapter (email/magic-link flows). Distinct from
// EmailVerificationToken below, which backs our own hashed-token verification.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  // sha-256 of the token we emailed. The raw token exists only in the link, so
  // a database leak does not hand an attacker working reset links.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// A signup that has been submitted but not yet confirmed from the inbox.
//
// This is what makes registration enumeration-resistant: no User row exists
// until someone proves control of the address, so the signup form can answer
// "check your inbox" identically whether or not the email is already taken.
//
// Holding the bcrypt hash (never the plaintext) means confirmation does not
// have to ask for the password again.
model PendingRegistration {
  id        String   @id @default(cuid())
  email     String
  password  String
  name      String?
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

// Backs two flows that are the same mechanism with different targets:
//   newEmail == null -> confirm the address already on the account
//   newEmail != null -> move the account to that address on redemption
//
// The link always goes to the address being *proved*, which for a change means
// the new one. That is what stops an attacker with a hijacked session from
// silently moving an account to an inbox they control.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  newEmail  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Fixed-window counters for the auth rate limiter. Lives in Postgres rather
// than memory because Vercel runs each request on a possibly-cold instance,
// so an in-process Map would reset constantly and limit nothing.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// A listing someone saved, stored as a full snapshot rather than a reference.
//
// Nothing in this app persists listings — they are fetched live from Wallapop,
// coches.net and Milanuncios on every search — and none of those source clients
// can fetch a single listing by id; they expose search only. A favorite holding
// just `(source, listingId)` would therefore have nothing to render, so the
// favorites page would be a list of ids.
//
// The cost is that the snapshot goes stale: a price drop is invisible until the
// user follows the link. The alternative, re-fetching every saved listing on
// page load, turns one page view into N calls against reverse-engineered APIs
// that already fail often enough to need `Promise.allSettled`. A page that
// always renders last week's price beats one that is blank when a source is
// down. See docs/specs/favorites.md.
model Favorite {
  id        String @id @default(cuid())
  userId    String
  // The normalized, source-prefixed listing id: `wallapop-abc123`. Already
  // unique across sources, so it needs no separate source column to be a key.
  listingId String

  // --- snapshot of CarListing at save time ---
  source   String
  title    String
  subtitle String
  image    String
  brand    String
  model    String
  location String
  fuel     String
  url      String
  price    Int
  mileage  Int
  year     Int
  lat      Float
  lng      Float

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Saving is a toggle a user can click twice in a second. This is what makes
  // "saving twice leaves one row" true in the database rather than in a
  // read-then-write race in application code.
  @@unique([userId, listingId])
  @@index([userId])
}

// One deduplicated question, polled once however many users subscribe to it.
//
// The dedup is not an optimisation, it is what keeps the feature affordable:
// every poll is three requests to reverse-engineered APIs behind bot
// protection, so a hundred users watching the same search must cost three
// requests, not three hundred. Getting the deployment's IP blocked would break
// search, not merely alerts. See docs/specs/alerts.md › Decisions and rationale.
model AlertCriteria {
  id String @id @default(cuid())

  // SHA-256 of the canonicalised SearchInput — keys sorted, undefined dropped,
  // arrays sorted — so filters that mean the same thing hash the same and share
  // one row regardless of how the object was built.
  criteriaHash String @unique
  // The SearchInput itself. Re-validated with searchSchema on read; never
  // trusted as typed just because it came from our own database.
  criteria     Json

  // Null until the first successful poll. Drives which criteria are due
  // (ALERT-10) and the reported lap age (ALERT-31).
  lastPolledAt DateTime?

  createdAt DateTime @default(now())

  alerts Alert[]
  seen   AlertSeenListing[]
  job    AlertPollJob?

  @@index([lastPolledAt])
}

// A user's subscription to a criteria set.
model Alert {
  id         String @id @default(cuid())
  userId     String
  criteriaId String

  // Human summary shown on the alerts page. A saved SearchInput is unreadable
  // as JSON, and someone with several alerts has to tell them apart.
  label String

  // Unsubscribing flips this rather than deleting, so the matches page still
  // renders and re-enabling loses no history. Only deleting the alert releases
  // the criteria set (see AlertCriteria's cascade).
  active Boolean @default(true)

  // SHA-256 of the token in the unsubscribe link. The raw value exists only in
  // the email, so a database leak does not hand over working links. Unlike a
  // password-reset token it never expires: an unsubscribe link in a year-old
  // email must still work, or the mail cannot be stopped.
  unsubscribeTokenHash String @unique

  createdAt DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  criteria AlertCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  matches  AlertMatch[]

  // Makes "saving the same search twice leaves one alert" true in the database
  // rather than in a read-then-write race.
  @@unique([userId, criteriaId])
  @@index([userId])
  @@index([criteriaId])
}

// The dedup memory, and the only definition of "new" available.
//
// No source exposes a usable publish date, and none can be ordered by recency
// once a location is set, so an alert cannot ask "what appeared since 09:05?".
// It asks "what is listed now?" and subtracts this. Deliberately holds no
// snapshot: these rows are numerous and mostly never emailed.
model AlertSeenListing {
  id         String @id @default(cuid())
  criteriaId String
  listingId  String
  // Which source produced it, so a source that failed contributes nothing and
  // its listings stay new (ALERT-17).
  source     String

  firstSeenAt DateTime @default(now())

  criteria AlertCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)

  // The backstop that holds even if two workers race past SKIP LOCKED.
  @@unique([criteriaId, listingId])
  @@index([criteriaId])
}

// One row per user per newly discovered listing, carrying the snapshot for the
// same reason Favorite does: no source client can fetch a single listing by id,
// so an email built from a reference alone would have nothing to render.
model AlertMatch {
  id        String @id @default(cuid())
  alertId   String
  listingId String

  // --- snapshot of CarListing at discovery time ---
  source   String
  title    String
  subtitle String
  image    String
  brand    String
  model    String
  location String
  fuel     String
  url      String
  price    Int
  mileage  Int
  year     Int
  lat      Float
  lng      Float

  // Null means pending delivery. Discovery and delivery are separate stages
  // because sendEmail returns false rather than throwing: a one-stage design
  // would mark a listing seen with nobody told, and it is never new again.
  notifiedAt DateTime?

  createdAt DateTime @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([alertId, listingId])
  @@index([alertId, notifiedAt])
}

// The queue. One row per criteria set, reused rather than appended, which makes
// "enqueuing twice leaves one job" a unique constraint instead of a check.
model AlertPollJob {
  id         String @id @default(cuid())
  criteriaId String @unique

  status   String @default("pending") // pending · running · failed
  attempts Int    @default(0)

  // Backoff: a retried job is not claimable until this passes. Deliberately
  // longer than the poll interval — a failing upstream should be polled less.
  availableAt DateTime @default(now())
  // Lease timestamp, so a worker killed mid-run does not strand its job.
  lockedAt    DateTime?
  lastError   String?

  // Claim order. A fair queue bounds the worst-case lag; an arbitrary one
  // bounds only the average, and the freshness target is about the worst case.
  enqueuedAt DateTime @default(now())

  criteria AlertCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)

  @@index([status, availableAt, enqueuedAt])
}

// Global, not per criteria: a broken parser breaks every criteria set at once,
// so recording it per criteria would be a thousand copies of one fact.
//
// This exists because a Milanuncios parse failure returns zero ads rather than
// an error. For search that is fewer results; for an alert it is
// indistinguishable from "nothing new", so an alert can be dead for weeks while
// looking healthy.
model SourceHealth {
  source               String    @id
  lastOkAt             DateTime?
  consecutiveEmptyRuns Int       @default(0)
  updatedAt            DateTime  @updatedAt
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
