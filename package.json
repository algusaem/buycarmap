{
  "name": "buycarmap",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.28.3",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrate-deploy.mjs && next build",
    "start": "next start",
    "lint": "cross-env SKIP_ENV_VALIDATION=1 biome check --error-on-warnings . && cross-env SKIP_ENV_VALIDATION=1 pnpm depcruise && cross-env SKIP_ENV_VALIDATION=1 knip && cross-env SKIP_ENV_VALIDATION=1 pnpm spec:check && cross-env SKIP_ENV_VALIDATION=1 pnpm docs:check && cross-env SKIP_ENV_VALIDATION=1 pnpm todo:check && cross-env SKIP_ENV_VALIDATION=1 impeccable detect app components lib",
    "typecheck": "tsc --noEmit && type-coverage",
    "db:up": "docker compose up -d",
    "db:down": "docker compose stop",
    "db:branch": "node scripts/db-branch.mjs",
    "db:branch:rm": "node scripts/db-branch.mjs --delete",
    "db:seed": "prisma db seed",
    "depcruise": "depcruise app components lib interfaces types server proxy.ts --config .dependency-cruiser.cjs",
    "gen": "plop",
    "spec:check": "node scripts/spec-check.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "todo:check": "node scripts/todo-check.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit --project node",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:e2e:db": "cross-env E2E_DB=1 playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test --project=visual",
    "test:contract": "vitest run --project node contract",
    "test:contract:live": "cross-env CONTRACT_LIVE=1 vitest run --project node contract",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:full": "pnpm check && pnpm test:e2e"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^5.2.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/nextjs": "^11.1.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@types/leaflet": "^1.9.21",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "motion": "^12.27.0",
    "next": "16.1.1",
    "next-auth": "^4.24.13",
    "next-intl": "^4.14.8",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "react-qr-code": "^2.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "^12.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.28",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^18.4.0",
    "husky": "^9.1.7",
    "impeccable": "4.1.0",
    "jsdom": "^29.1.1",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "msw": "^2.14.6",
    "node-plop": "0.32.3",
    "pino-pretty": "^13.1.3",
    "plop": "^4.0.5",
    "prisma": "^7.2.0",
    "tailwindcss": "^4",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "type-coverage": "^2.30.1",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  },
  "typeCoverage": {
    "atLeast": 99.3,
    "ignoreFiles": [
      "app/generated/**",
      ".next/**"
    ]
  },
  "lint-staged": {
    "*": "biome check --write --error-on-warnings --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
