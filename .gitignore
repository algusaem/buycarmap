# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which documents the required variables and holds no
# real values. Without this exception a new deploy has nothing to copy from.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
nul

# testing
/test-results
/playwright-report
/blob-report

# using pnpm — keep npm from re-creating this
/package-lock.json

# local Claude Code tooling. Ignored by default, with two exceptions: the slash
# commands and the project hook config are project source, not personal setup —
# CLAUDE.md mandates a workflow (/spec, /spec-tests, /check-all) that cannot run
# without them, and a rule that only exists on one machine is not a rule.
# Per-user permissions, the dev-server launch config and worktrees stay out.
/.claude/*
!/.claude/commands/
!/.claude/settings.json
