# Copy to `.env` and fill in. Everything under "Required" is validated at
# startup by lib/env.ts — the app refuses to boot if any of it is missing,
# rather than failing later with an opaque error.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Local Postgres connection string, used by the Prisma pg driver adapter.
# `pnpm db:up` starts the Compose Postgres this points at, on localhost:5433.
#
# On a feature branch this is written for you by `pnpm db:branch`, which gives
# the branch its own database inside that same Compose Postgres. Leave the
# main checkout's value alone.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/buycarmap"

# ---------------------------------------------------------------------------
# Tooling (optional — not read by the app, absent from lib/env.ts)
# ---------------------------------------------------------------------------

# Overrides the admin connection `pnpm db:branch` uses to create and drop
# per-branch databases inside the Compose Postgres. Only needed when the
# default (postgresql://postgres:postgres@localhost:5433/postgres) does not
# match your local setup.
# LOCAL_DATABASE_ADMIN_URL="postgresql://postgres:postgres@localhost:5433/postgres"

# Signs every Better Auth session cookie and token. Generate with:
#   openssl rand -base64 32
# Must be at least 32 characters — lib/auth/auth.ts logs a loud warning below
# that, because a short secret weakens the HMAC protecting every session.
# Rotating this signs everyone out.
BETTER_AUTH_SECRET=""

# Canonical origin of the deployment. Also decides whether session cookies are
# marked Secure: set an https:// URL in production or cookies ship without it.
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Tooling — env validation
# ---------------------------------------------------------------------------
# Skips lib/env.ts's validation at import time. Set by `pnpm lint` (through
# cross-env) so a lint run needs no database credentials; never set this for
# `pnpm dev`, `pnpm build` or `pnpm start`, or a missing variable stops
# failing loudly at boot.
# SKIP_ENV_VALIDATION="1"

# ---------------------------------------------------------------------------
# Optional — database migrations (Neon direct connection)
# ---------------------------------------------------------------------------
# An unpooled connection string for Prisma's migration commands
# (prisma.config.ts). Falls back to DATABASE_URL when unset, so local work
# needs no second variable — only set this where DATABASE_URL is the pooled
# (`-pooler`) host, i.e. on Vercel.
# DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Optional — error monitoring (Sentry)
# ---------------------------------------------------------------------------
# Inert without a DSN: nothing is initialised and nothing is sent. Create the
# project at sentry.io in the EU region, then set the server and client DSNs
# (usually the same value) and, to upload source maps at build time, an
# auth token scoped to the org and project below.
# SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
# NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG="buycarmap"
# SENTRY_PROJECT="buycarmap"

# ---------------------------------------------------------------------------
# Optional — transactional email (password reset, security notices)
# ---------------------------------------------------------------------------
# Without both of these the mailer no-ops and logs a warning. The app still
# runs, but: password-reset links are never delivered, and registration falls
# back to creating accounts immediately — which reveals whether an address is
# already registered. Setting these enables verify-first signup and closes that.

# https://resend.com → API Keys
RESEND_API_KEY=""

# Must be an address on a domain verified with Resend (SPF/DKIM), or mail will
# be rejected or land in spam.
EMAIL_FROM="BuyCarMap <no-reply@example.com>"

# OPTIONAL OVERRIDE — most deployments should leave this unset.
#
# Base URL for links inside emails. Resolution order:
#   APP_URL -> BETTER_AUTH_URL -> https://$VERCEL_URL -> http://localhost:3000
#
# Since BETTER_AUTH_URL is already the app's origin, this is only worth setting
# when the two genuinely differ — e.g. a custom domain in front of a
# *.vercel.app deployment, where emails should show the pretty domain.
# On Vercel previews, leave it unset so the VERCEL_URL fallback makes each
# deployment link to itself rather than to production.
# APP_URL="https://buycarmap.com"


# ---------------------------------------------------------------------------
# Optional — rate limiting (Upstash Redis)
# ---------------------------------------------------------------------------
# Without both of these, lib/platform/rate-limit.ts disables rate limiting —
# allows every request and logs one warning per process — rather than
# refusing to boot. lib/env.ts requires both when VERCEL_ENV is "production"
# or "preview", so a deploy without them fails the build.
#
# Local development, e2e and the integration tests do not need Upstash: there
# is no local Redis any more, because @upstash/ratelimit's Lua scripts carry
# a Redis flag that is an Upstash-only extension, which a real local Redis
# rejects outright (docs/decisions/0017-upstash-qstash-react-email.md). The
# service's own rate-limit tests inject an in-memory sliding-window fake
# instead (test/fakes/ratelimit.ts).
#
# Production and preview use the values from an Upstash Redis database
# created in the EU (Frankfurt) region — console.upstash.com → Redis →
# REST API — set in Vercel, never here.
# UPSTASH_REDIS_REST_URL="https://example.upstash.io"
# UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Optional — car alerts (QStash)
# ---------------------------------------------------------------------------
# QStash signs and schedules the call to POST /api/alerts/run every five
# minutes. Without these the route refuses every request, so alerts never
# fire — the app still boots.
#
# From the Upstash console (console.upstash.com → QStash):
#   QSTASH_TOKEN                — scripts/qstash-schedule.mjs's own auth,
#                                 to create/update the schedule. Run that
#                                 script once after the variables below are
#                                 set in Vercel and the app is deployed.
#   QSTASH_CURRENT_SIGNING_KEY  — verifies the Upstash-Signature header
#   QSTASH_NEXT_SIGNING_KEY       lib/platform/qstash.ts checks requests
#                                 against; accepting both lets a key rotation
#                                 in the console skip a deploy.
#
# Alerts additionally need RESEND_API_KEY and EMAIL_FROM to deliver anything.
# Without them the runner still records matches — they appear on /alerts — and
# reports `skippedNoEmail` rather than pretending it sent them.
QSTASH_URL=""
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# ---------------------------------------------------------------------------
# Optional — OAuth providers
# ---------------------------------------------------------------------------
# A provider is registered only when BOTH halves of its pair are set; otherwise
# its button does not render at all. Callback URLs to register in each console:
#   ${APP_URL}/api/auth/callback/google
#   ${APP_URL}/api/auth/callback/github
# Add both the local and production URLs.

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GITHUB_ID=""
GITHUB_SECRET=""

# ---------------------------------------------------------------------------
# Optional — upstream marketplace base URLs (e2e only)
# ---------------------------------------------------------------------------
# Override the real Wallapop/coches.net/Milanuncios hosts server/search/service.ts
# calls. Only ever set by Playwright's webServer (playwright.config.ts), which
# points all three at the local mock upstream server
# (e2e/fixtures/upstream-server.ts) so a Playwright run never reaches a real
# marketplace. Production never sets these.
# WALLAPOP_API_BASE_URL="https://api.wallapop.com"
# COCHESNET_API_BASE_URL="https://web.gw.coches.net"
# MILANUNCIOS_BASE_URL="https://www.milanuncios.com"
